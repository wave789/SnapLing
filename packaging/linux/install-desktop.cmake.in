# Use the installation-time prefix, including `cmake --install --prefix` overrides.
# Portal's GDesktopAppInfo lookup must find the executable even when ~/.local/bin is not in its PATH.
set(snapling_bindir "@CMAKE_INSTALL_BINDIR@")
if(IS_ABSOLUTE "${snapling_bindir}")
    set(snapling_executable "${snapling_bindir}/snapling")
else()
    set(snapling_executable "${CMAKE_INSTALL_PREFIX}/${snapling_bindir}/snapling")
endif()
# Quote for the Exec argv parser, then encode backslashes for the desktop-entry string parser.
string(REPLACE "\\" "\\\\" snapling_executable "${snapling_executable}")
string(REPLACE "\"" "\\\"" snapling_executable "${snapling_executable}")
string(REPLACE "`" "\\`" snapling_executable "${snapling_executable}")
string(REPLACE "$" "\\$" snapling_executable "${snapling_executable}")
string(REPLACE "\\" "\\\\" snapling_executable "${snapling_executable}")
string(REPLACE "%" "%%" snapling_executable "${snapling_executable}")
file(READ [==[@PROJECT_SOURCE_DIR@/packaging/linux/io.snapling.SnapLing.desktop]==] snapling_desktop)
string(REPLACE "Exec=snapling" "Exec=\"${snapling_executable}\"" snapling_desktop "${snapling_desktop}")
set(snapling_desktop_stage [==[@CMAKE_CURRENT_BINARY_DIR@/install-desktop/io.snapling.SnapLing.desktop]==])
file(MAKE_DIRECTORY [==[@CMAKE_CURRENT_BINARY_DIR@/install-desktop]==])
file(WRITE "${snapling_desktop_stage}" "${snapling_desktop}")
# file(INSTALL) handles DESTDIR, standard directory modes and the install manifest.
file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/share/applications" TYPE FILE
     FILES "${snapling_desktop_stage}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
