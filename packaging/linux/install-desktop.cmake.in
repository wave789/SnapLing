# Use the installation-time prefix, including `cmake --install --prefix` overrides.
# Portal's GDesktopAppInfo lookup must find the executable even when ~/.local/bin is not in its PATH.
set(snapling_bindir "@CMAKE_INSTALL_BINDIR@")
if(IS_ABSOLUTE "${snapling_bindir}")
    set(snapling_executable "${snapling_bindir}/snapling")
else()
    set(snapling_executable "${CMAKE_INSTALL_PREFIX}/${snapling_bindir}/snapling")
endif()
set(SNAPLING_DESKTOP_EXECUTABLE "${snapling_executable}")
set(SNAPLING_DESKTOP_DESTINATION "${CMAKE_INSTALL_PREFIX}/share/applications")
set(SNAPLING_DESKTOP_STAGE [==[@CMAKE_CURRENT_BINARY_DIR@/install-desktop]==])
include([==[@PROJECT_SOURCE_DIR@/packaging/linux/desktop-entry.cmake]==])
